# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# API Security (Change this to a secure random key in production)
API_KEY=your-secret-key-change-this

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ecopack
DB_USER=postgres
DB_PASSWORD=your_password_here

# Optional: Python Environment Password (for ETL scripts)
ECOPACKAI_DB_PASSWORD=your_password_here
